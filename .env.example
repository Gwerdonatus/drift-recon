# ============================================================
# DATA DRIFT RECONCILIATION SERVICE — ENVIRONMENT TEMPLATE
# Copy to .env and fill in values. NEVER commit .env to git.
# ============================================================

# --- Application ---
ENVIRONMENT=production          # development | staging | production
LOG_LEVEL=INFO                  # DEBUG | INFO | WARNING | ERROR
APP_VERSION=1.0.0

# --- Database (PostgreSQL) ---
POSTGRES_USER=recon_user
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD_32CHARS
POSTGRES_DB=reconciliation
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://recon_user:CHANGE_ME_STRONG_PASSWORD_32CHARS@postgres:5432/reconciliation
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT=30

# --- Redis ---
REDIS_URL=redis://:CHANGE_ME_REDIS_PASSWORD@redis:6379/0
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# --- Security ---
# Generate with: openssl rand -hex 32
SECRET_KEY=CHANGE_ME_openssl_rand_hex_32
API_KEY_SALT=CHANGE_ME_openssl_rand_hex_16
# Comma-separated list of valid API keys (hashed at startup)
VALID_API_KEYS=key1_CHANGE_ME,key2_CHANGE_ME

# --- Matching Engine ---
MATCH_CONFIDENCE_THRESHOLD=0.75   # Minimum score to auto-match
MATCH_REVIEW_THRESHOLD=0.50       # Below this = unmatched
AMOUNT_TOLERANCE_PERCENT=0.01     # 1% tolerance on amount
DATE_TOLERANCE_DAYS=3
WEIGHT_AMOUNT=0.50
WEIGHT_DATE=0.25
WEIGHT_REFERENCE=0.15
WEIGHT_DESCRIPTION=0.10

# --- Drift Detection ---
DRIFT_LOOKBACK_DAYS=30            # Rolling window for baseline
DRIFT_ZSCORE_THRESHOLD=2.5       # Std devs before flagging drift
DRIFT_MIN_SNAPSHOTS=7            # Minimum snapshots for baseline

# --- Scheduler ---
RECONCILIATION_CRON=0 */6 * * *  # Run every 6 hours
DRIFT_CHECK_CRON=0 8 * * *       # Run daily at 08:00

# --- Alerts (optional webhook, e.g., Slack) ---
ALERT_WEBHOOK_URL=
ALERT_ON_DRIFT=true
ALERT_ON_LOW_MATCH_RATE=true
ALERT_MATCH_RATE_THRESHOLD=0.80

# --- Dashboard ---
API_BASE_URL=http://api:8000
DASHBOARD_PORT=8501
